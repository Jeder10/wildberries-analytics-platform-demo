model Model
	culture: ru-RU
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: ru-RU
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Товары","Активность","Календарь","Остатки","История остатков","Финансы","Валюты","Воронка","Типы отчётов","Анализ продаж","DemoMode","PgServer","PgDatabase"]

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode"]

ref table Товары
ref table Активность
ref table Календарь
ref table Остатки
ref table 'История остатков'
ref table Финансы
ref table Валюты
ref table Воронка
ref table 'Типы отчётов'
ref table 'Анализ продаж'
